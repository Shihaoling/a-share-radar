[Unit]
Description=Publish A-share trend observations from completed trading sessions
After=ashare-asset-research.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Nice=12
WorkingDirectory=/opt/ashare-radar-preview/runtime
Environment=PYTHONPATH=/opt/ashare-radar-preview/runtime
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/var/lib/ashare-radar-preview/venv/bin/python /opt/ashare-radar-preview/deploy/tencent-preview/trend_observations.py
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/ashare-radar-preview/quote-output /var/lib/ashare-radar-preview/asset-research
ProtectHome=yes
PrivateTmp=yes
