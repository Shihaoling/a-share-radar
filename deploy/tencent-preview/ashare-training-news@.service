[Unit]
Description=A-share Radar historical news %i
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
UMask=0077
Environment=PYTHONPATH=/opt/ashare-radar-preview/runtime
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=RADAR_SERVICE_GATE_FILE=/var/lib/ashare-radar-preview/relay/rate-gate.json
LoadCredential=sxdata-token:/etc/ashare-radar-preview/sxdata-token
LoadCredential=minimax-key:/etc/ashare-radar-preview/minimax-key
ExecStart=/var/lib/ashare-radar-preview/venv/bin/python /opt/ashare-radar-preview/deploy/tencent-preview/training_news.py %i
TimeoutStartSec=285
MemoryMax=450M
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/ashare-radar-preview
ProtectHome=yes
PrivateTmp=yes
Nice=8
