{
  "indicators": {
    "cn_pmi": {
      "country": "中国",
      "name": "制造业 PMI",
      "short_name": "制造业 PMI",
      "definition": "制造业采购经理指数由企业月度调查编制，用于衡量订单、生产、用工等活动相较上月的变化方向和广度。50 是临界值，高于 50 表示总体扩张，低于 50 表示总体收缩。",
      "formula": "分类指数＝回答增加的企业占比＋0.5×回答持平的企业占比（以百分数计）。\n制造业 PMI＝新订单指数×30%＋生产指数×25%＋从业人员指数×20%＋（100－供应商配送时间指数）×15%＋原材料库存指数×10%。",
      "method_url": "https://www.stats.gov.cn/zs/tjws/zytjzbqs/cgzlzs/202501/t20250121_1958396.html"
    },
    "cn_cpi": {
      "country": "中国",
      "name": "居民消费价格指数（CPI）",
      "short_name": "CPI",
      "definition": "衡量城乡居民购买的代表性商品和服务的价格水平变化。各消费类别按其在居民支出中的比重加权，可用于观察消费端通胀。",
      "formula": "CPI 同比涨幅＝（本月 CPI ÷ 上年同月 CPI－1）×100%。\nCPI 环比涨幅＝（本月 CPI ÷ 上月 CPI－1）×100%。",
      "method_url": "https://www.stats.gov.cn/xw/tjxw/tzgg/202302/P020230202401909231437.pdf"
    },
    "cn_ppi": {
      "country": "中国",
      "name": "工业生产者出厂价格指数（PPI）",
      "short_name": "PPI",
      "definition": "衡量工业企业产品首次出售时的出厂价格变化。指数综合各类工业产品的价格与销售权重，用于观察生产端价格走势。",
      "formula": "PPI 同比涨幅＝（本月 PPI ÷ 上年同月 PPI－1）×100%。\nPPI 环比涨幅＝（本月 PPI ÷ 上月 PPI－1）×100%。",
      "method_url": "https://www.stats.gov.cn/xw/tjxw/tzgg/202302/P020230202401909231437.pdf"
    },
    "cn_retail": {
      "country": "中国",
      "name": "社会消费品零售总额",
      "short_name": "社零",
      "definition": "统计企业和个体经营户向个人及社会集团销售的非生产、非经营用途实物商品金额，以及提供餐饮服务取得的收入。它主要反映商品消费和餐饮市场的经营规模。",
      "formula": "社会消费品零售总额＝商品零售额＋餐饮收入。\n同比增速＝（本期总额 ÷ 上年同口径同期总额－1）×100%。",
      "method_url": "https://www.stats.gov.cn/zs/tjws/zytjzbqs/shxfp/202409/t20240910_1956343.html"
    },
    "us_gdp": {
      "country": "美国",
      "name": "国内生产总值（GDP）",
      "short_name": "GDP",
      "definition": "衡量一定时期内美国境内生产的最终产品和服务的价值。名义 GDP 按当期价格计量，实际 GDP 剔除价格变动，以便比较产出。随着资料补齐，季度初值会经历后续修订。",
      "formula": "名义 GDP（支出法）＝个人消费支出＋国内私人总投资＋政府消费与投资＋出口－进口。\n实际 GDP 季度增速（折年率）＝［（本季实际 GDP ÷ 上季实际 GDP）⁴－1］×100%。",
      "method_url": "https://www.bea.gov/news/blog/2025-06-03/expenditures-approach-measuring-gdp"
    },
    "us_pce": {
      "country": "美国",
      "name": "个人消费支出价格指数（PCE）",
      "short_name": "PCE",
      "definition": "衡量美国居民消费的商品和服务价格变化，涵盖居民直接支付和第三方为其支付的支出，例如雇主医保支付的医疗费用。核心 PCE 剔除食品和能源价格。",
      "formula": "PCE 同比涨幅＝（本月 PCE 价格指数 ÷ 上年同月 PCE 价格指数－1）×100%。\n综合指数按相邻时期的消费支出权重，以链式费雪方法编制。",
      "method_url": "https://www.bea.gov/help/faq/521"
    },
    "us_jobs": {
      "country": "美国",
      "name": "非农就业",
      "short_name": "非农",
      "definition": "根据雇主调查估计政府和非农私营部门的工资岗位数，常关注经季节调整后的月度净变化。统计单位是岗位，一人兼任多份工作时可计入多个岗位。结果会随样本补报而修订。",
      "formula": "非农就业月度净增＝本月经季节调整的非农工资岗位数－上月经季节调整的非农工资岗位数。",
      "method_url": "https://www.bls.gov/bls/empsitquickguide.htm"
    },
    "us_cpi": {
      "country": "美国",
      "name": "消费者价格指数（CPI）",
      "short_name": "CPI",
      "definition": "衡量美国城市消费者购买的一篮子商品和服务的价格变化，各类别以消费支出为基础加权。核心 CPI 剔除食品和能源，用于观察较持续的价格变化。",
      "formula": "CPI 同比涨幅（通常用未季调指数）＝（本月 CPI ÷ 上年同月 CPI－1）×100%。\nCPI 环比涨幅（通常用季调指数）＝（本月 CPI ÷ 上月 CPI－1）×100%。",
      "method_url": "https://www.bls.gov/opub/hom/cpi/calculation.htm"
    }
  },
