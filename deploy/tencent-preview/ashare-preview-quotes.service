[Unit]
Description=A-share Radar bounded fallback quote preview
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/ashare-radar-preview/runtime
Environment=PYTHONPATH=/opt/ashare-radar-preview/runtime
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/lib/ashare-radar-preview/browsers
ExecStart=/var/lib/ashare-radar-preview/venv/bin/python /opt/ashare-radar-preview/deploy/tencent-preview/jobs.py quotes
TimeoutStartSec=180
MemoryMax=1400M
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/ashare-radar-preview
ProtectHome=yes
PrivateTmp=yes
