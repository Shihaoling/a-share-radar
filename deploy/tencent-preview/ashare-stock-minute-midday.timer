[Unit]
Description=Backfill missing stock and board minutes during the midday break

[Timer]
OnCalendar=Mon..Fri *-*-* 11:36:07 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 12:12:34 Asia/Shanghai
AccuracySec=2s
RandomizedDelaySec=4s
Persistent=true
Unit=ashare-stock-minute-recovery@midday.service

[Install]
WantedBy=timers.target
