[Unit]
Description=Refresh Hong Kong and U.S. index intraday fallback quotes
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
UMask=0077
Environment=PYTHONPATH=/opt/ashare-radar-preview/runtime
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/var/lib/ashare-radar-preview/venv/bin/python /opt/ashare-radar-preview/deploy/tencent-preview/global_intraday.py
TimeoutStartSec=50
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/ashare-radar-preview/quote-output
ProtectHome=yes
