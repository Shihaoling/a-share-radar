[Unit]
Description=A-share Radar website accounts and administration
After=local-fs.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
UMask=0077
WorkingDirectory=/opt/ashare-radar-preview/runtime
Environment=PYTHONPATH=/opt/ashare-radar-preview/runtime
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=RADAR_SERVICE_GATE_FILE=/var/lib/ashare-radar-preview/relay/rate-gate.json
RuntimeDirectory=ashare-account
RuntimeDirectoryMode=0750
StateDirectory=ashare-radar-preview/account
StateDirectoryMode=0700
ExecStart=/var/lib/ashare-radar-preview/venv/bin/python -u /opt/ashare-radar-preview/deploy/tencent-preview/account_service.py serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/ashare-radar-preview/account
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
MemoryMax=180M

[Install]
WantedBy=multi-user.target
