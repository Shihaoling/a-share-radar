[Unit]
Description=Schedule A-share Radar cloud news %i

[Timer]
OnCalendar=*-*-* *:00/10:19 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 09:30..58/2:19 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 10,13,14:00/2:19 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 11:00..28/2:19 Asia/Shanghai
AccuracySec=1s
Persistent=true

[Install]
WantedBy=timers.target
