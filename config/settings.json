  "repository_url": "https://github.com/Shihaoling/a-share-radar",
  "notes": "浏览器偏好不改变本文件。模型使用已完成交易日；神经网络默认关闭，启用后仍须通过样本外基线比较。",
  "min_train": 120,
  "holdout_size": 20,
  "funds": {
    "enabled": true,
    "max_requests": 4,
    "min_interval_seconds": 3
  },
  "equity": {
    "enabled": true,
    "history_days": 180,
    "max_requests": 2,
    "min_interval_seconds": 6,
    "minimum_weight_coverage": 0.9,
    "retrain_days": 7
  }
